# ------------------------------------------------------------------
# BioRep Labs — Apache settings for the built site
#
# This file lives in public/, so "npm run build" copies it into dist/.
# Upload everything inside dist/ to the web root, including this file.
# It is hidden on most systems: switch on "show hidden files" when
# uploading, or the page addresses below will not work.
#
# The site must be served from the root of its domain
# (https://example.com/), not from a sub-folder.
# ------------------------------------------------------------------

# Do not list folder contents, and do not guess at file names.
Options -Indexes
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Text is UTF-8.
AddDefaultCharset utf-8

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddCharset utf-8 .css .js .mjs .json .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS -------------------------------------------------------
  # Switched off so the site still loads on a domain with no SSL
  # certificate. Once the certificate is installed, remove the "#"
  # from the three lines below to send every visitor to https://.
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Hidden files ------------------------------------------------
  # Never serve files or folders whose name starts with a dot
  # (.git, .env), in case one is uploaded by mistake.
  RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

  # --- Missing files -----------------------------------------------
  # A script, stylesheet or image that no longer exists is a real
  # "not found", not the home page standing in for it. The same goes
  # for /.well-known/, which hosts use to issue SSL certificates.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(assets|\.well-known)/ - [R=404,L]

  # --- Page addresses ----------------------------------------------
  # The site is a single-page app. Addresses such as
  # /news/who-budget-cuts are not files on the server, so every
  # address that is not a real file or folder is answered with
  # index.html, and the app then shows the right page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# If the server has no rewrite module, fall back to the app for unknown addresses.
<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.html
</IfModule>

# --- Caching -------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  # The page itself is always re-checked, so a new upload shows straight away.
  ExpiresByType text/html "access plus 0 seconds"

  # The build puts a fingerprint in every script and stylesheet name
  # (index-M09RW-Yf.css), so a changed file always has a new name
  # and the old one can safely be kept for a year.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Images include the logo files, which keep the same name when replaced.
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# --- Compression ---------------------------------------------------
# Send text files gzip-compressed. Photos are already compressed.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>

# --- Security headers ----------------------------------------------
<IfModule mod_headers.c>
  # Browsers must not guess a file's type.
  Header always set X-Content-Type-Options "nosniff"

  # Other websites may not show this site inside a frame.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Share only the site's address, not the full page, when a visitor follows a link out.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The site never needs the camera, microphone or location.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # After the HTTPS lines above are switched on, remove the "#" below
  # so browsers remember to use https:// for the next year.
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
